{# ==========================================================================
   Security License Lens — v2 "What matters most" partial (C-section).

   Renders the prioritized top moves. Binding contract: this partial is
   consumed with `build_sections(result)["C"]`, which returns `result.moves`
   verbatim. The engine already caps the list at 3
   (runner.py: rank_moves(findings, limit=3, ...)); this template MUST NOT
   slice, cap, or reorder the list. The model order is the rank order —
   authoritative, never re-sorted here.

   TopMove payload fields: title, why, effort_label, check_ids,
   customer_next_step, deep_link.

   DESIGN_V3 dashboard+panel: title rows open the detail panel when JS is on;
   full why/effort/link stay in `.move-body` for no-JS + print + panel source.

   Retained v1 rules (section 9): no emoji, no <img>, no external URLs except
   deep_link, empty optional fields omit their row without crashing.
   ========================================================================== #}

{%- set move_list = moves if moves is defined else (result.moves if result is defined else []) -%}

    {% if move_list %}
    <section id="section-c" class="reveal-target" style="--reveal-delay: 0ms">
      <p class="micro-label section-kicker">Priorities</p>
      <h2>What matters most</h2>
      <p class="section-help section-help--linear">
        Ranked by security impact, evidence confidence, and estimated effort.
      </p>
      <p class="section-help section-help--dashboard">
        Open a row for why, effort, and the admin path. Summary stays put.
      </p>
      <ol class="move-list">
        {% for move in move_list %}
        {%- set _action = (move.customer_next_step or '') | trim | trim('.') -%}
        {%- set _title = (move.title or '') | trim | trim('.') -%}
        {%- set _show_action = _action and _action | lower != _title | lower -%}
        <li class="move-item{% if loop.first %} move-item--lead{% endif %}" id="move-{{ loop.index }}">
          <span class="move-index move-index--linear">{{ '%02d' | format(loop.index) }}</span>
          <button
            type="button"
            class="move-open"
            data-panel="move-{{ loop.index }}"
            aria-controls="detail-panel"
            aria-expanded="false"
          >
            <span class="move-index">{{ '%02d' | format(loop.index) }}</span>
            <strong class="move-title">{{ move.title }}</strong>
            <span class="move-open__hint" aria-hidden="true">→</span>
          </button>
          <div class="move-body" data-panel-source="move-{{ loop.index }}">
            <div class="move-head move-head--linear">
              <strong class="move-title">{{ move.title }}</strong>
            </div>
            {% if move.effort_label %}<p class="move-meta effort-label">Effort: {{ move.effort_label }}</p>{% endif %}
            {% if move.why %}<p class="move-why">{{ move.why }}</p>{% endif %}
            {% if _show_action %}<p class="move-action"><strong>Action:</strong> {{ move.customer_next_step }}</p>{% endif %}
            {% if move.deep_link %}<p class="move-link"><a href="{{ move.deep_link }}">Open the admin page</a></p>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ol>
      <p class="move-note">
        Effort is a rough guide, not a quote.
      </p>
    </section>
    {% endif %}
